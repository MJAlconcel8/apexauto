# Copy this file to .env for local backend development.
# Railway values belong in Railway -> backend service -> Variables, never in Git.

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/apexauto_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=apexauto_user
SPRING_DATASOURCE_PASSWORD=apexauto_password

# Persistent schema and quiet SQL logging.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Comma-separated allowed frontend origin patterns.
CORS_ALLOWED_ORIGINS=http://localhost:*

# Local HTTP defaults. On Railway with a Vercel *.vercel.app frontend, use true + None.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Required Base64-encoded 256-bit secret. Generate with: openssl rand -base64 32
JWT_SECRET_KEY=
JWT_EXPIRATION_TIME=2592000000

# SMTP settings. Gmail requires an App Password rather than the account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Gemini chatbot settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CHATBOT_MAX_OUTPUT_TOKENS=300
